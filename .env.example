# NewsAPI Configuration
# Get your free API key at: https://newsapi.org/register
VITE_NEWS_API_KEY=your_newsapi_key_here
NEWS_API_KEY=your_newsapi_key_here

# NVIDIA NIM / Nemotron Configuration (primary reasoning model)
# Get your API key at: https://build.nvidia.com
NVIDIA_API_KEY=your_nvidia_api_key_here
NIM_ENDPOINT=https://integrate.api.nvidia.com/v1
NEMOTRON_MODEL=nvidia/llama-3.3-nemotron-super-49b-v1
NVIDIA_EMBED_MODEL=nvidia/nv-embedqa-e5-v5

# Google Gemini Configuration (web-grounded search fallback ONLY)
# Get your free API key at: https://aistudio.google.com/apikey
# Gemini is used ONLY to retrieve web info when news context is insufficient.
# It does NOT replace Nemotron for reasoning or final answers.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.0-flash

# Server port
PORT=3001
